  "rules": [
    {
      "rule_id": "CONV-DIM-001",
      "version": "1.0.0",
      "status": "proposed",
      "title": "Dimension annotation, not wall",
      "domain": "line_purpose",
      "source": {
        "document": "USACE A/E/C Graphics Standard",
        "release": "Release 2.2",
        "section": "5.5",
        "pages": [
          64,
          65,
          66,
          67,
          68
        ],
        "local_reference_id": "usace-graphics-2.2",
        "citation_status": "needs_local_reference_check"
      },
      "evidence_requirements": [
        "dimension_text",
        "witness_lines",
        "terminators",
        "parallel_pair"
      ],
      "result": {
        "classification": "dimension_annotation_candidate",
        "constraints": [
          "Do not extrude dimension annotations",
          "Project detail takes precedence"
        ]
      },
      "precedence": [
        "project_documents",
        "project_standards",
        "general_references"
      ],
      "review": "always_required",
      "assumptions": [
        "Reference conventions are context-specific clues, not project requirements."
      ],
      "negative_examples": [
        "partial dimension strings",
        "parallel walls without dimension evidence"
      ],
      "tests": [
        "rule-library:CONV-DIM-001:positive",
        "rule-library:CONV-DIM-001:missing-evidence",
        "rule-library:CONV-DIM-001:source-isolation"
      ]
    },
